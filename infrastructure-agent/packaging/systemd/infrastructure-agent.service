[Unit]
Description=Generic Infrastructure Agent
Documentation=https://github.com/wkarts/dockge/tree/main/infrastructure-agent
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/infrastructure-agent/agent.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/infra-agent --config /etc/infrastructure-agent/agent.json run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/infrastructure-agent /etc/infrastructure-agent

[Install]
WantedBy=multi-user.target
