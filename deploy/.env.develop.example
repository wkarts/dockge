# Dockge — develop/homologação
DOCKGE_IMAGE=ghcr.io/wkarts/dockge
DOCKGE_IMAGE_TAG=develop
DOCKGE_BIND_HOST=127.0.0.1
DOCKGE_PORT=5001
DOCKGE_DATA_PATH=./data
DOCKGE_STACKS_PATH=/opt/stacks

# Superfícies administrativas
DOCKGE_ENABLE_CONSOLE=false
DOCKGE_ALLOW_DISABLE_AUTH=false
DOCKGE_TOTP_ISSUER=Dockge Develop

# API REST máquina-a-máquina. Os arquivos ficam no volume persistente.
DOCKGE_API_TOKENS_FILE=/app/data/api-tokens.json
DOCKGE_API_AUDIT_FILE=/app/data/api-audit.jsonl
