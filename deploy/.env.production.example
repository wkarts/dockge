# Dockge — produção
DOCKGE_IMAGE=ghcr.io/wkarts/dockge
# Bootstrap: latest. Após a primeira release independente validada, fixe aqui
# a tag SemVer exata publicada pelo fluxo main (ex.: 1.6.0) para produção.
# Não presuma que uma tag existe antes de confirmar o pacote no GHCR.
DOCKGE_IMAGE_TAG=latest
DOCKGE_BIND_HOST=127.0.0.1
DOCKGE_PORT=5001
DOCKGE_DATA_PATH=./data
DOCKGE_STACKS_PATH=/opt/stacks

# Segurança humana/admin. Não exponha a porta 5001 diretamente à internet;
# publique-a atrás de um reverse proxy TLS quando acesso remoto for necessário.
DOCKGE_ENABLE_CONSOLE=false
DOCKGE_ALLOW_DISABLE_AUTH=false
DOCKGE_TOTP_ISSUER=Dockge

# API REST máquina-a-máquina. Os arquivos ficam no volume persistente.
DOCKGE_API_TOKENS_FILE=/app/data/api-tokens.json
DOCKGE_API_AUDIT_FILE=/app/data/api-audit.jsonl
