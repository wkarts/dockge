DOCKGE_MANAGER_IMAGE=ghcr.io/wkarts/dockge-manager
DOCKGE_MANAGER_TAG=latest
DOCKGE_MANAGER_BIND_HOST=127.0.0.1
DOCKGE_MANAGER_PORT=8010
DOCKGE_MANAGER_DATABASE_URL=postgresql+psycopg://dockge_manager:dockge_manager@postgres:5432/dockge_manager
DOCKGE_MANAGER_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
DOCKGE_MANAGER_FERNET_KEY=CHANGE_ME_FERNET_KEY
DOCKGE_MANAGER_ADMIN_EMAIL=admin@example.com
DOCKGE_MANAGER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DOCKGE_MANAGER_ALLOW_HTTP_TARGETS=false
