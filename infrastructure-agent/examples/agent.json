{
  "data_dir": "/var/lib/infrastructure-agent",
  "poll_interval_seconds": 30,
  "labels": {
    "owner": "customer",
    "environment": "production"
  },
  "controllers": [
    {
      "name": "pige360",
      "base_url": "https://api.pige360.com.br",
      "enrollment_file": "/etc/infrastructure-agent/secrets/pige360-enrollment.credential",
      "credential_file": "/var/lib/infrastructure-agent/controllers/pige360/access.credential",
      "agent_identity_file": "/var/lib/infrastructure-agent/controllers/pige360/agent.id",
      "allowed_deployment_prefixes": ["pige360-"]
    },
    {
      "name": "connect-api",
      "base_url": "https://control.example.com",
      "enrollment_file": "/etc/infrastructure-agent/secrets/connect-api-enrollment.credential",
      "credential_file": "/var/lib/infrastructure-agent/controllers/connect-api/access.credential",
      "agent_identity_file": "/var/lib/infrastructure-agent/controllers/connect-api/agent.id",
      "allowed_deployment_prefixes": ["connect-api-"]
    }
  ],
  "dockge": {
    "base_url": "http://127.0.0.1:5001",
    "credential_file": "/etc/infrastructure-agent/secrets/dockge-api.credential"
  }
}
