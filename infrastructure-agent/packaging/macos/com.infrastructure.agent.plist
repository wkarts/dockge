<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.infrastructure.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/infra-agent</string>
    <string>--config</string>
    <string>/Library/Application Support/InfrastructureAgent/agent.json</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/InfrastructureAgent.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/InfrastructureAgent.error.log</string>
</dict>
</plist>
